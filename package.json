{
  "name": "n8n-nodes-physalis",
  "version": "1.0.2",
  "description": "n8n community node for Physalis — fetch secrets, services and app accounts from your Physalis vault, without copying them into n8n.",
  "keywords": [
    "n8n-community-node-package",
    "physalis",
    "secrets",
    "vault",
    "credentials",
    "secrets-management"
  ],
  "license": "MIT",
  "homepage": "https://physalis.cloud/en/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physalis-cloud/physalis-n8n-nodes.git"
  },
  "bugs": {
    "url": "https://github.com/physalis-cloud/physalis-n8n-nodes/issues"
  },
  "author": {
    "name": "Argoweb",
    "email": "contact@argoweb.fr"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PhysalisApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Physalis/Physalis.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.65.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
